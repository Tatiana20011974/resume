Content-Type: application/x-www-form-urlencoded
Accept: application/json

client_id=resumeID&username=admin&password=12345&client_secret=w9E3StaKRRxAKgeqqukYhCVyJEMC4KUA&grant_type=password&scope=openid profile email

> {% client.global.set("auth_token", response.body.access_token); %}